# =====================================================================
# SGS Backend — Environment variables template
#
# Copy this file to `.env` and adjust the values for your environment:
#   cp .env.example .env
#
# Spring Boot does NOT read `.env` automatically: export these values
# before running `./mvnw spring-boot:run`, or load them with your IDE
# (e.g. IntelliJ "EnvFile" plugin, VS Code launch config `envFile`).
# Never commit the real `.env` — keep secrets out of git.
# =====================================================================

# ---------------------------------------------------------------------
# Database (application.yaml → spring.datasource)
# Defaults below mirror the local development fallbacks.
# ---------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/stock_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ---------------------------------------------------------------------
# JWT (application.yaml → jwt.*)
#
# The fallback secret baked into application.yaml is VOLUNTARILY PUBLIC
# (it has always been in git history): only use it for throwaway local
# development — every token signed with it must be considered untrusted.
# Generate a real secret:  openssl rand -base64 64
#
# The `prod` profile REFUSES to start without JWT_SECRET
# (see application-prod.yaml).
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------
# SMTP (application.yaml → spring.mail.*)
#
# Empty by default: without credentials, email sending fails silently
# (best-effort — see EmailService). For Gmail, use an App Password.
# ---------------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=
